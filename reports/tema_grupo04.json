{
  "name": "Grupo 04 - Reingresos",
  "dataColors": [
    "#1F3B63",
    "#C25A3C",
    "#4A7FB5",
    "#5A6472",
    "#8AA6C8",
    "#A8521F",
    "#2E8B74",
    "#B08A3E"
  ],
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "backgroundNeutral": "#E3E8EF",
  "foreground": "#15202B",
  "foregroundNeutralSecondary": "#5A6472",
  "foregroundNeutralTertiary": "#8A94A3",
  "tableAccent": "#1F3B63",
  "good": "#2E8B74",
  "neutral": "#B08A3E",
  "bad": "#C25A3C",
  "maximum": "#1F3B63",
  "center": "#8AA6C8",
  "minimum": "#E3E8EF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1F3B63"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F3B63"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#15202B"
    },
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 34,
      "color": "#15202B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E3E8EF" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#9AA7B8" } },
            "position": "Outer",
            "preset": "Simple",
            "shadowSpread": 3,
            "shadowBlur": 8,
            "transparency": 70
          }
        ],
        "padding": [
          { "top": 10, "bottom": 10, "left": 12, "right": 12 }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F3B63" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": { "solid": { "color": "#8A94A3" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0,
            "border": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F6F9" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#EDF0F5" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#15202B" } },
            "fontSize": 32,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#5A6472" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#5A6472" } },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#8A94A3" } },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#E8ECF2" } },
            "gridlineThickness": 1
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#15202B" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#5A6472" } },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#8A94A3" } },
            "fontSize": 9,
            "gridlineColor": { "solid": { "color": "#E8ECF2" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#15202B" } },
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E8ECF2" } },
            "rowPadding": 6,
            "outlineColor": { "solid": { "color": "#E3E8EF" } },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1F3B63" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Center"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#15202B" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#15202B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#15202B" } },
            "backColorSecondary": { "solid": { "color": "#F7F9FC" } },
            "fontSize": 10
          }
        ],
        "subTotals": [
          {
            "fontColor": { "solid": { "color": "#1F3B63" } },
            "backColor": { "solid": { "color": "#EDF1F7" } },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#1F3B63" } },
            "backColor": { "solid": { "color": "#EDF1F7" } },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1F3B63" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#15202B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#15202B" } },
            "backColorSecondary": { "solid": { "color": "#F7F9FC" } },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#15202B" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10,
            "outline": "None"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F3B63" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          { "show": false }
        ],
        "border": [
          { "show": false }
        ],
        "dropShadow": [
          { "show": false }
        ]
      }
    }
  }
}
